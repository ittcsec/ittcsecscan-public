    { "op": "fact_present", "fact": "acl_all_users" }
  ] },
  "requires": { "nodes": ["data_store"], "completeness": ["s3.bucketConfig"] },
  "confidence": { "base": 80, "factors": [
    { "name": "provider_policy_is_public", "when": { "op": "fact_equals", "fact": "policy_is_public", "value": "true" }, "delta": 15 },
    { "name": "acl_all_users", "when": { "op": "fact_present", "fact": "acl_all_users" }, "delta": 5 }
  ] }
}
