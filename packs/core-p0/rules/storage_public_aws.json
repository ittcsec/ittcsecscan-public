{
  "id": "CORE-P0-STORAGE-PUBLIC-AWS",
  "version": "1",
  "pack_id": "core-p0",
  "severity": "high",
  "title": "S3 bucket is publicly accessible",
  "detail": "The bucket policy grants public access, or its ACL grants access to all users. Public buckets expose their objects to anyone on the internet.",
  "selector": { "node_type": "data_store", "predicate": { "op": "fact_absent", "fact": "engine" } },
